library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity EXEMPLO_LCD_FPGA_EE03 is
    generic (fclk: natural := 50_000_000); 
    port (
        clk, reset_n : in  std_logic;
        data_line1, data_line2 : in  std_logic_vector(127 downto 0);
        update_cmd : in  std_logic;
        busy : out std_logic;
        RS, RW, E : out std_logic;  
        DB : out std_logic_vector(7 downto 0)
    );
end EXEMPLO_LCD_FPGA_EE03;

architecture hardware of EXEMPLO_LCD_FPGA_EE03 is
    type state is (PowerOn, FunctionSet1, FunctionSet2, FunctionSet3, DisplayControl, ClearDisplay, EntryMode, IDLE, SetAddressLine1, WriteLine1, SetAddressLine2, WriteLine2, UpdateComplete);
    signal pr_state : state := PowerOn;
    signal busy_internal : std_logic := '1'; 
    signal data_reg1, data_reg2 : std_logic_vector(127 downto 0);
    signal char_index : integer range 0 to 15 := 0;
    type char_array is array (0 to 15) of std_logic_vector(7 downto 0);
    signal line1_chars, line2_chars : char_array;
    constant CLK_DIV_LIMIT : integer := fclk / 500; 
    signal clk_counter : integer range 0 to CLK_DIV_LIMIT := 0;
    signal tick_enable : std_logic := '0';
    signal E_internal : std_logic := '0';
begin
    E <= E_internal; busy <= busy_internal; RW <= '0';
    process (data_reg1, data_reg2) begin
        for i in 0 to 15 loop
            line1_chars(i) <= data_reg1((127 - i*8) downto (120 - i*8));
            line2_chars(i) <= data_reg2((127 - i*8) downto (120 - i*8));
        end loop;
    end process;
    
    process(clk, reset_n) begin
        if reset_n = '0' then clk_counter <= 0; tick_enable <= '0';
        elsif rising_edge(clk) then
            if clk_counter >= CLK_DIV_LIMIT - 1 then clk_counter <= 0; tick_enable <= '1';
            else clk_counter <= clk_counter + 1; tick_enable <= '0'; end if;
        end if;
    end process;

    process(clk, reset_n) begin
        if reset_n = '0' then
            pr_state <= PowerOn; busy_internal <= '1'; E_internal <= '0'; RS <= '0'; DB <= (others=>'0');
        elsif rising_edge(clk) then
            if pr_state = IDLE then
                busy_internal <= '0';
                if update_cmd = '1' then
                    data_reg1 <= data_line1; data_reg2 <= data_line2; busy_internal <= '1'; pr_state <= SetAddressLine1;
                end if;
            end if;
            if tick_enable = '1' then
                if pr_state /= IDLE then E_internal <= not E_internal; else E_internal <= '0'; end if;
                if E_internal = '1' then 
                    case pr_state is
                        when PowerOn => DB <= "00111000"; pr_state <= FunctionSet1;
                        when FunctionSet1 => DB <= "00111000"; pr_state <= FunctionSet2;
                        when FunctionSet2 => DB <= "00111000"; pr_state <= FunctionSet3;
                        when FunctionSet3 => DB <= "00000001"; pr_state <= ClearDisplay;
                        when ClearDisplay => DB <= "00001100"; pr_state <= DisplayControl;
                        when DisplayControl => DB <= "00000110"; pr_state <= EntryMode;
                        when EntryMode => busy_internal <= '0'; pr_state <= IDLE;
                        when SetAddressLine1 => RS <= '0'; DB <= "10000000"; char_index <= 0; pr_state <= WriteLine1;
                        when WriteLine1 => RS <= '1'; DB <= line1_chars(char_index);
                            if char_index = 15 then pr_state <= SetAddressLine2; else char_index <= char_index + 1; end if;
                        when SetAddressLine2 => RS <= '0'; DB <= "11000000"; char_index <= 0; pr_state <= WriteLine2;
                        when WriteLine2 => RS <= '1'; DB <= line2_chars(char_index);
                            if char_index = 15 then pr_state <= UpdateComplete; else char_index <= char_index + 1; end if;
                        when UpdateComplete => busy_internal <= '0'; pr_state <= IDLE;
                        when IDLE => null;
                        when others => pr_state <= PowerOn;
                    end case;
                end if; 
            end if; 
        end if; 
    end process;
end architecture hardware;

-- =================================================================
-- 6. BUFFER CONTROLLER (lcd_buffer_controller)
-- =================================================================
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity lcd_buffer_controller is
    Port (
        clk, reset_n, update_req, lcd_busy : in std_logic;
        text_line1, text_line2 : in std_logic_vector(127 downto 0);
        lcd_data1, lcd_data2 : out std_logic_vector(127 downto 0);
        lcd_update : out std_logic
    );
end lcd_buffer_controller;

architecture Behavioral of lcd_buffer_controller is
    constant BUFFER_SIZE : integer := 3;
    type buffer_array_t is array (0 to BUFFER_SIZE-1) of std_logic_vector(255 downto 0);
    signal buffer_fifo : buffer_array_t;
    signal write_ptr, read_ptr : integer range 0 to BUFFER_SIZE-1 := 0;
    signal buffer_count : integer range 0 to BUFFER_SIZE := 0;
    signal buffer_empty, buffer_full : std_logic;
    signal last_sent_data : std_logic_vector(255 downto 0) := (others => '0');
    signal last_sent_valid, reset_sync, update_req_sync, update_req_edge : std_logic := '0';
    type state_t is (IDLE, CHECK_BUFFER, COMPARE_DATA, SEND_TO_LCD, WAIT_LCD);
    signal current_state, next_state : state_t;
    signal current_combined : std_logic_vector(255 downto 0);
begin
    process(clk) begin
        if rising_edge(clk) then
            reset_sync <= not reset_n;
            if reset_sync = '1' then update_req_sync <= '0'; update_req_edge <= '0';
            else update_req_sync <= update_req; update_req_edge <= update_req and not update_req_sync; end if;
        end if;
    end process;

    buffer_empty <= '1' when buffer_count = 0 else '0';
    buffer_full  <= '1' when buffer_count = BUFFER_SIZE else '0';
    current_combined <= buffer_fifo(read_ptr);

    process(current_state, buffer_empty, lcd_busy, current_combined, last_sent_data, last_sent_valid)
    begin
        next_state <= current_state; lcd_update <= '0'; lcd_data1 <= (others=>'0'); lcd_data2 <= (others=>'0');
        case current_state is
            when IDLE => next_state <= CHECK_BUFFER;
            when CHECK_BUFFER => if buffer_empty = '0' then next_state <= COMPARE_DATA; else next_state <= IDLE; end if;
            when COMPARE_DATA => 
                if (last_sent_valid = '1') and (current_combined = last_sent_data) then next_state <= CHECK_BUFFER; 
                else next_state <= SEND_TO_LCD; end if;
            when SEND_TO_LCD =>
                lcd_data1 <= current_combined(255 downto 128); lcd_data2 <= current_combined(127 downto 0);
                lcd_update <= '1'; next_state <= WAIT_LCD;
            when WAIT_LCD =>
                lcd_data1 <= current_combined(255 downto 128); lcd_data2 <= current_combined(127 downto 0);
                if lcd_busy = '0' then next_state <= CHECK_BUFFER; else next_state <= WAIT_LCD; end if;
            when others => next_state <= IDLE;
        end case;
    end process;

    process(clk)
        variable write_op, read_op : boolean;
    begin
        if rising_edge(clk) then
            if reset_sync = '1' then
                current_state <= IDLE; write_ptr <= 0; read_ptr <= 0; buffer_count <= 0;
                last_sent_valid <= '0'; last_sent_data <= (others=>'0'); buffer_fifo <= (others=>(others=>'0'));
            else
                current_state <= next_state; write_op := false; read_op := false;
                if update_req_edge = '1' then
                    if (last_sent_valid = '1' and (text_line1 & text_line2) = last_sent_data) then null;
                    elsif buffer_full = '0' then
                        buffer_fifo(write_ptr) <= text_line1 & text_line2;
                        if write_ptr = BUFFER_SIZE-1 then write_ptr <= 0; else write_ptr <= write_ptr + 1; end if;
                        write_op := true;
                    end if;
                end if;
                if current_state = SEND_TO_LCD then
                    last_sent_data <= buffer_fifo(read_ptr); last_sent_valid <= '1'; read_op := true;
                elsif current_state = COMPARE_DATA and (last_sent_valid = '1' and buffer_fifo(read_ptr) = last_sent_data) then
                    read_op := true;
                end if;
                if read_op then
                    if read_ptr = BUFFER_SIZE-1 then read_ptr <= 0; else read_ptr <= read_ptr + 1; end if;
                end if;
                if write_op and not read_op then buffer_count <= buffer_count + 1;
                elsif not write_op and read_op then buffer_count <= buffer_count - 1; end if;
            end if;
        end if;
    end process;
end Behavioral;

-- =================================================================
-- 7. TOP LEVEL UNIFICADO (Top_Quiz)
-- =================================================================
library ieee;
use ieee.std_logic_1164.all;

entity Top_Quiz is
    generic (
        SAFETY_CYCLES : integer := 2500000; 
        EGG_CYCLES    : integer := 100000000;
        FCLK_VALUE    : natural := 50_000_000 
    );
    port (
        clk, reset_n, ps2_clk, ps2_data, btn_start : in std_logic;
        lcd_rs_out, lcd_rw_out, lcd_write_en_out : out std_logic;
        lcd_data_out : out std_logic_vector(7 downto 0);
        quiz_finished : out std_logic
    );
end entity Top_Quiz;

architecture Structural of Top_Quiz is
    signal key_value : std_logic_vector(3 downto 0);
    signal key_valid : std_logic;
    signal questao_texto1 : std_logic_vector(127 downto 0);
    signal questao_resposta : std_logic_vector(7 downto 0);
    
    signal questao_index : integer := 0; 
    
    signal display_linha1, display_linha2 : std_logic_vector(127 downto 0);
    signal core_lcd_update : std_logic;
    signal connect_data1, connect_data2 : std_logic_vector(127 downto 0);
    signal connect_update, connect_busy : std_logic;

    component PS2_Keyboard_Buffered port (
        clk, reset_n, ps2_clk, ps2_data : in std_logic;
        key_value : out std_logic_vector(3 downto 0); key_valid : out std_logic);
    end component;
    
    component Question_Bank generic (TOTAL_QUESTIONS : integer); port (
        clk : in std_logic; 
        question_index : in integer;
        question_text1 : out std_logic_vector(127 downto 0); 
        correct_answer : out std_logic_vector(7 downto 0));
    end component;
    
    component Quiz_Core_Minimal generic (MAX_QUESTOES_BANCO, SAFETY_CYCLES : integer); port (
        clk, reset_n : in std_logic; key_value : in std_logic_vector(3 downto 0); 
        key_valid, btn_start : in std_logic;
        questao_texto1 : in std_logic_vector(127 downto 0); 
        questao_resposta : in std_logic_vector(7 downto 0);
        questao_index : out integer; 
        display_linha1, display_linha2 : out std_logic_vector(127 downto 0);
        lcd_update_req, quiz_finished : out std_logic);
    end component;
    
    component lcd_buffer_controller port (
        clk, reset_n, update_req, lcd_busy : in std_logic;
        text_line1, text_line2 : in std_logic_vector(127 downto 0);
        lcd_data1, lcd_data2 : out std_logic_vector(127 downto 0); 
        lcd_update : out std_logic);
    end component;
    
    component EXEMPLO_LCD_FPGA_EE03 generic (fclk: natural); port (
        clk, reset_n : in std_logic; 
        data_line1, data_line2 : in std_logic_vector(127 downto 0);
        update_cmd : in std_logic; busy : out std_logic;
        RS, RW, E : out std_logic; DB : out std_logic_vector(7 downto 0));
    end component;
begin
    lcd_rw_out <= '0';
    ps2_inst: PS2_Keyboard_Buffered port map (clk=>clk, reset_n=>reset_n, ps2_clk=>ps2_clk, ps2_data=>ps2_data, key_value=>key_value, key_valid=>key_valid);
    banco_inst: Question_Bank generic map (TOTAL_QUESTIONS=>8) port map (clk=>clk, question_index=>questao_index, question_text1=>questao_texto1, correct_answer=>questao_resposta);
    core_inst: Quiz_Core_Minimal generic map (MAX_QUESTOES_BANCO=>8, SAFETY_CYCLES=>SAFETY_CYCLES) port map (
        clk=>clk, reset_n=>reset_n, key_value=>key_value, key_valid=>key_valid, btn_start=>btn_start, 
        questao_texto1=>questao_texto1, questao_resposta=>questao_resposta, questao_index=>questao_index,
        display_linha1=>display_linha1, display_linha2=>display_linha2, lcd_update_req=>core_lcd_update, quiz_finished=>quiz_finished);
    lcd_buffer_inst: lcd_buffer_controller port map (
        clk=>clk, reset_n=>reset_n, text_line1=>display_linha1, text_line2=>display_linha2, update_req=>core_lcd_update,
        lcd_busy=>connect_busy, lcd_data1=>connect_data1, lcd_data2=>connect_data2, lcd_update=>connect_update);
    lcd_sender_inst: EXEMPLO_LCD_FPGA_EE03 generic map (fclk=>FCLK_VALUE) port map (
        clk=>clk, reset_n=>reset_n, data_line1=>connect_data1, data_line2=>connect_data2, update_cmd=>connect_update,
        busy=>connect_busy, RS=>lcd_rs_out, RW=>open, E=>lcd_write_en_out, DB=>lcd_data_out);
end architecture Structural;